# Copier vers .env :  cp .env.example .env
# Ne jamais committer le fichier .env

# ==================== DJANGO ====================
SECRET_KEY=django-insecure-CHANGEZ-MOI-50-CARACTERES-MIN
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
# Ajoute ton IP LAN pour tests mobile (ipconfig → IPv4), ex: 172.20.10.4
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2,django,172.20.10.4

# ==================== POSTGRESQL ====================
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=CHANGEZ-MOI-PG
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecommerce_user:CHANGEZ-MOI-PG@postgres:5432/ecommerce_db

# ==================== MONGODB ====================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGEZ-MOI-MG
MONGO_INITDB_DATABASE=ecommerce_catalog
MONGODB_URL=mongodb://admin:CHANGEZ-MOI-MG@mongodb:27017/ecommerce_catalog?authSource=admin
MONGO_DB_NAME=ecommerce_catalog

# ==================== REDIS / CELERY ====================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==================== JWT (Django ↔ FastAPI : même clé) ====================
JWT_SECRET_KEY=jwt-CHANGEZ-MOI-32-CARACTERES-MIN
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== EMAIL (optionnel — confirmation commande) ====================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-application-gmail
DEFAULT_FROM_EMAIL=votre@gmail.com
